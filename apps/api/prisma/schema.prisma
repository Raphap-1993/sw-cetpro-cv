generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CONTENT_EDITOR
  ADMISSIONS_MANAGER
  VIEWER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
  DISCARDED
}

enum ContentBlockType {
  HERO
  SECTION
  CTA
  TEXT
  IMAGE
  FAQ
}

enum MediaAssetType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

enum MediaAssetSource {
  EXTERNAL_URL
  LOCAL_UPLOAD
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Program {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  description String?
  studyPlan   String?
  duration    String?
  modality    String?
  imageUrl    String?
  position    Int           @default(0)
  status      PublishStatus @default(DRAFT)
  leads       Lead[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, position])
}

model Lead {
  id        String     @id @default(cuid())
  fullName  String
  phone     String
  email     String
  message   String?
  source    String     @default("public_web")
  status    LeadStatus @default(NEW)
  programId String?
  program   Program?   @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([programId])
}

model ContentBlock {
  id        String           @id @default(cuid())
  page      String
  key       String
  type      ContentBlockType
  title     String?
  body      String?
  mediaUrl  String?
  position  Int              @default(0)
  status    PublishStatus    @default(DRAFT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([page, key])
  @@index([page, status])
}

model MediaAsset {
  id        String         @id @default(cuid())
  title     String
  altText   String?
  url       String         @unique
  type      MediaAssetType @default(IMAGE)
  source    MediaAssetSource @default(EXTERNAL_URL)
  storageKey String?       @unique
  status    PublishStatus  @default(PUBLISHED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, type])
}
