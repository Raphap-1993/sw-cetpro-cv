# Adapt this into a custom Hestia Nginx template or include file.
# Replace:
# - __DOMAIN__
# - __API_PORT__
# - __WEB_PORT__
# - __MEDIA_UPLOAD_DIR__

upstream swcv_api {
  server 127.0.0.1:__API_PORT__;
  keepalive 32;
}

upstream swcv_web {
  server 127.0.0.1:__WEB_PORT__;
  keepalive 32;
}

server {
  listen 80;
  server_name __DOMAIN__;
  client_max_body_size 25m;

  location ^~ /media/ {
    alias __MEDIA_UPLOAD_DIR__/;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location ^~ /api/ {
    proxy_pass http://swcv_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
  }

  location / {
    proxy_pass http://swcv_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
  }
}
